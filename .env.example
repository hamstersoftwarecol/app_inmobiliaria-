# ---------------------------------------------------------------------------
# Hitlease Real Estate — Docker Compose environment (copy to .env).
# NEVER commit real secrets. Generate APP_KEY with:
#   docker compose run --rm api php artisan key:generate --show
# ---------------------------------------------------------------------------
APP_NAME="Hitlease Real Estate API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Web front-end (used in password-reset / verification links and CORS)
FRONTEND_URL=http://localhost
AGENCY_TIMEZONE=America/New_York

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hitlease
DB_USERNAME=hitlease
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# In production set to the parent domain, e.g. .hitlease.com
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Comma separated hosts allowed to use cookie (SPA) authentication
SANCTUM_STATEFUL_DOMAINS=localhost
# Mobile token lifetime in minutes (default 30 days)
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=hls_

CORS_ALLOWED_ORIGINS=http://localhost

# Require TOTP MFA for staff (super_admin, broker, office_manager) on admin routes
SECURITY_ENFORCE_STAFF_MFA=true
# Shared secret between the Next.js server and the API (per-visitor rate limits for SSR).
# Generate with `openssl rand -hex 32`; set the same value for the web server. Empty = disabled.
API_SSR_KEY=
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_DECAY_SECONDS=900
SECURITY_AUTH_REQUESTS_PER_MINUTE=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 (S3 compatible) — configured in a later sprint
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# MLS integrations are DISABLED until signed data-licence agreements and
# official credentials exist. Credentials are stored encrypted in the DB,
# never in this file.
MLS_SYNC_ENABLED=false
# Reconcile refuses to hide more than this share of a provider's listings in one run.
MLS_RECONCILE_MAX_REMOVAL_RATIO=0.2

# Listing photos. "public" needs `php artisan storage:link`; Cloudflare R2 (s3) is pending credentials.
MEDIA_DISK=public

# Observability (leave empty to disable)
SENTRY_LARAVEL_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Docker Compose only ---
HTTP_PORT=80
NEXT_PUBLIC_API_URL=http://api.localhost
NEXT_PUBLIC_SITE_URL=http://localhost
