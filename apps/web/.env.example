# Public (shipped to the browser) — never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (not shipped to the browser): API base URL reachable from the
# Next.js server for SSR, when it differs from the public one (e.g. Docker).
# API_INTERNAL_URL=http://api-internal

# Server-only: same value as the API's API_SSR_KEY so SSR requests are rate-limited per visitor.
# API_SSR_KEY=
